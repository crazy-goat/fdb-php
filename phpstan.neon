includes:
    # The PHP <= 8.3 stubs declare FFI::new(), FFI::cast() and FFI::type() as nullable
    # (?FFI\CData / ?FFI\CType) in their reflection stubs, while the functions
    # never return null. php-src corrected the prototypes in PHP 8.4 (commit
    # a37a3d3d81, php-src #16075), so analysing at the PHP 8.2 floor reports
    # those calls as possibly null. The baseline contains only these stub false
    # positives; do not add null handling to the FFI wrappers to silence them,
    # the implementation cannot return null. Regenerate the baseline after
    # changing the FFI call sites.
    - phpstan-baseline.neon

parameters:
    # The package floor is PHP 8.2 (composer.json `php: >=8.2`,
    # config.platform.php 8.2.0), so analysis must target 8.2 too.
    phpVersion: 80200
    level: 9
    paths:
        - src
        - tests
    excludePaths:
        - tests/bindingtester

    ignoreErrors:
        - identifier: method.notFound
          path: src/NativeClient.php
        - identifier: property.notFound
          path: src/NativeClient.php
        - identifier: method.staticCall
          path: src/NativeClient.php
        - identifier: method.notFound
          path: src/FoundationDB.php
        - identifier: method.notFound
          path: src/Database.php
        - identifier: method.notFound
          path: src/Transaction.php
        - identifier: method.notFound
          path: src/ReadTransaction.php
        - identifier: method.notFound
          path: src/RangeResult.php
        - identifier: method.notFound
          path: src/Tenant.php
        - identifier: method.notFound
          path: src/Option/NetworkOptions.php
        - identifier: method.notFound
          path: src/Future/*.php
        - identifier: property.notFound
          path: src/Future/*.php
        - identifier: method.notFound
          path: src/FDBException.php
        - identifier: method.staticCall
          path: src/BlobGranuleReadContext.php
        - identifier: property.notFound
          path: src/BlobGranuleReadContext.php
        - identifier: argument.type
          path: src/BlobGranuleReadContext.php
