parameters:
    level: 9
    paths:
        - src
        - tests
    ignoreErrors:
        - identifier: method.notFound
          path: src/NativeClient.php
        - identifier: property.notFound
          path: src/NativeClient.php
        - identifier: method.staticCall
          path: src/NativeClient.php
        - identifier: method.notFound
          path: src/FoundationDB.php
        - identifier: method.notFound
          path: src/Database.php
        - identifier: method.notFound
          path: src/Transaction.php
        - identifier: property.notFound
          path: src/Transaction.php
        - identifier: method.notFound
          path: src/ReadTransaction.php
        - identifier: method.notFound
          path: src/RangeResult.php
        - identifier: method.notFound
          path: src/Tenant.php
        - identifier: method.notFound
          path: src/Option/NetworkOptions.php
        - identifier: property.onlyWritten
          path: src/Snapshot.php
        - identifier: method.notFound
          path: src/Future/*.php
        - identifier: property.notFound
          path: src/Future/*.php
        - identifier: method.notFound
          path: src/FDBException.php
