# Single source of the FDB port numbers for the compose stack (issue #189).
#
# docker-compose.yml reads these values for each service's FDB_PORT, its
# port-mapping target and default, and the coordinator string; the compose file
# itself contains no port literals. The host-side override variables
# FDB_COORD_*_PORT / FDB_SERVER_*_PORT default to these values, so exporting
# them (bin/worktree.sh writes .env.worktree) still moves only the host mapping.
#
# Keep these five assignments as the source of truth; the unit test
# ComposeFdbPortSingleSourceTest pins them and fails if a port literal returns
# to docker-compose.yml.
FDB_COORD_1_CONTAINER_PORT=4500
FDB_COORD_2_CONTAINER_PORT=4501
FDB_COORD_3_CONTAINER_PORT=4502
FDB_SERVER_1_CONTAINER_PORT=4510
FDB_SERVER_2_CONTAINER_PORT=4511
