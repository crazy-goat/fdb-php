{
    "name": "crazy-goat/fdb-php",
    "description": "FoundationDB client for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hałas Piotr",
            "email": "halaspiotr@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "2.3.1",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "2.6.7"
    },
    "suggest": {
        "ext-ffi": "Required for the native FoundationDB client bindings",
        "ext-gmp": "Required for arbitrary-precision integer support in the tuple layer"
    },
    "autoload": {
        "psr-4": {
            "CrazyGoat\\FoundationDB\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrazyGoat\\FoundationDB\\Tests\\": "tests/",
            "CrazyGoat\\FoundationDB\\Tests\\BindingTester\\": "tests/bindingtester/"
        }
    },
    "scripts": {
        "lint": "bin/lint.sh",
        "lint:fix": "bin/lint.sh --fix",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:bindingtester": "bash tests/bindingtester/run.sh",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "config": {
        "sort-packages": true
    }
}
