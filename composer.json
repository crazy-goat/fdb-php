{
    "name": "crazy-goat/fdb-php",
    "description": "FoundationDB client for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hałas Piotr",
            "email": "halaspiotr@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.8",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "2.6.3",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "suggest": {
        "ext-ffi": "Required for the native FoundationDB client bindings",
        "ext-gmp": "Required for arbitrary-precision integer support in the tuple layer"
    },
    "autoload": {
        "psr-4": {
            "CrazyGoat\\FoundationDB\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrazyGoat\\FoundationDB\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": ["phpcs --standard=phpcs.xml.dist", "@rector", "@phpstan"],
        "lint:fix": ["@rector:fix", "phpcbf --standard=phpcs.xml.dist"],
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs-fix": "phpcbf --standard=phpcs.xml.dist",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
