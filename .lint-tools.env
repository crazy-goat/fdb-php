# shellcheck shell=bash
# shellcheck disable=SC2034
# Single source of truth for the lint tool versions and the SHA-256 checksums of
# their release assets. Sourced by bin/lint.sh and the CI lint job.
#
# When bumping a tool, update its version and checksum together from the release
# URL named above it.
#
# Release asset: shellcheck
# https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz
LINT_SHELLCHECK_VERSION=0.11.0
LINT_SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# Release asset: hadolint
# https://github.com/hadolint/hadolint/releases/download/v2.12.0/hadolint-Linux-x86_64
LINT_HADOLINT_VERSION=2.12.0
LINT_HADOLINT_SHA256=56de6d5e5ec427e17b74fa48d51271c7fc0d61244bf5c90e828aab8362d55010

# Release asset: actionlint
# https://github.com/rhysd/actionlint/releases/download/v1.7.7/actionlint_1.7.7_linux_amd64.tar.gz
LINT_ACTIONLINT_VERSION=1.7.7
LINT_ACTIONLINT_SHA256=023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757
